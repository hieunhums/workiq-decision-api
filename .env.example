# Copy to .env.local and fill in. See README, "Quick start".

# ---- Required ---------------------------------------------------------------

# Jev routes every workplace question. Key from https://typesafe.ai
TYPESAFE_API_KEY=

# Azure AI Foundry resource hostname. Authenticated with Entra: `az login`
# locally, managed identity in a container. No key.
FOUNDRY_HOST=your-resource.openai.azure.com
# Chat model deployment. Answers typed questions and plays the "LLM choice" mode.
CHAT_DEPLOYMENT=gpt-5.4-mini

# Work IQ: set at least one of the two ways in.
# 1. The local Work IQ CLI, signed in. Full path, from `which workiq`.
WORKIQ_PATH=
# 2. Sign in with Microsoft on the page. A web app registration with a client
#    secret, redirect URI <origin>/api/auth/callback, and the delegated
#    permissions listed in the README under "Auth".
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=organizations
# Set when behind a proxy whose request host is an internal one.
AUTH_REDIRECT_URI=

# Grounds "today" and reads times back in the person's zone instead of UTC.
USER_TIME_ZONE=Asia/Singapore
USER_COUNTRY=SG

# ---- Optional ---------------------------------------------------------------

# Voice. Leave empty for a text-only app: the Talk button and Voice toggle
# are hidden and no realtime deployment is needed.
REALTIME_DEPLOYMENT=gpt-realtime-2.1

# Microsoft Web IQ, for the search_web tool. Empty means workplace data only.
WEBIQ_API_KEY=
